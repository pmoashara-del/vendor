# Template for environment variables.
# Option A: Edit ".env.local" in this folder (Next.js loads it automatically — file may be hidden in Explorer).
# Option B: Copy this file and rename the copy to ".env.local"
# Same idea as .env.example — this filename has no leading dot so it shows in Windows Explorer.

# Supabase (public + server)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Server-only: Supabase Dashboard → Settings → API → service_role (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin dashboard (browser cookie session is signed with this secret)
ADMIN_DASHBOARD_PASSWORD=change_me_to_a_long_password
ADMIN_SESSION_SECRET=change_me_to_a_random_32_plus_char_secret

# IFSC verification: uses Razorpay public API https://ifsc.razorpay.com/{IFSC} — no key_id / key_secret required.

# Admin AI (OpenAI — server only; never exposed to vendors)
OPENAI_API_KEY=
# Optional override (default gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Resend — emails after registration & after approval (server only)
RESEND_API_KEY=
# Sender must be verified in Resend. For quick tests use Resend's onboarding sender:
# RESEND_FROM=Indore Araz Vendor Portal <onboarding@resend.dev>

# Optional: used in email templates as "Open portal" link
# NEXT_PUBLIC_APP_URL=https://localhost:3000
