# Duplicate without leading dot: env.example (easier to see in Windows Explorer)
# Supabase (public + server)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Server-only: Supabase Dashboard → Settings → API → service_role (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin dashboard (browser cookie session is signed with this secret)
ADMIN_DASHBOARD_PASSWORD=change_me_to_a_long_password
ADMIN_SESSION_SECRET=change_me_to_a_random_32_plus_char_secret

# IFSC: Razorpay public IFSC API (ifsc.razorpay.com) — no Razorpay payment keys required.

# OpenAI (admin AI insights only — add key to enable)
OPENAI_API_KEY=

# Resend (transactional email — server only)
RESEND_API_KEY=
# Verified sender, e.g. "Indore Araz <noreply@yourdomain.com>" — use Resend onboarding address for tests:
# RESEND_FROM=Indore Araz Vendor Portal <onboarding@resend.dev>

# Optional: link in emails to your deployed site
# NEXT_PUBLIC_APP_URL=https://your-domain.com
